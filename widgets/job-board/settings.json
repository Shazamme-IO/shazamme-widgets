      "default": "Next"
    },
    {
      "key": "pagerLabel",
      "type": "text",
      "default": "Job pages"
    },
    {
      "key": "showSort",
      "type": "boolean",
      "default": true
    },
    {
      "key": "defaultSort",
      "type": "dropdown",
      "default": "newest",
      "options": [
        "newest",
        "salary-high",
        "salary-low"
      ]
    },
    {
      "key": "sortLabel",
      "type": "text",
      "default": "Sort by"
