    {
      "key": "showWorkModel",
      "type": "boolean",
      "default": false
    },
    {
      "key": "emptyTitle",
      "type": "text",
      "default": "No jobs match your search"
    },
    {
      "key": "emptyText",
      "type": "text",
      "default": "Try removing a filter or searching for something broader."
    },
    {
      "key": "noJobsText",
      "type": "text",
      "default": "There are no live jobs right now. Check back soon."
