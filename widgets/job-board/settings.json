    {
      "key": "sortSalaryLow",
      "type": "text",
      "default": "Lowest salary"
    },
    {
      "key": "countOne",
      "type": "text",
      "default": "{count} job"
    },
    {
      "key": "countMany",
      "type": "text",
      "default": "{count} jobs"
    },
    {
      "key": "cardLabel",
      "type": "dropdown",
      "default": "profession",
      "options": [
        "profession",
        "role",
        "none"
      ]
    },
    {
      "key": "headingTag",
      "type": "dropdown",
      "default": "h3",
      "options": [
        "h2",
        "h3",
        "h4",
        "p"
      ]
    },
    {
      "key": "showSalary",
      "type": "boolean",
      "default": true
    },
    {
      "key": "noSalaryText",
      "type": "text",
