<div class="shm-flip-cards" data-shm-flip-cards>
  <div class="shm-fc-grid" data-shm-fc-grid></div>
  <div class="shm-fc-sources">
    {{#each cards}}
    <div class="shm-fc-src">
      <span data-f="image">{{image}}</span>
      <span data-f="alt">{{alt}}</span>
      <span data-f="title">{{title}}</span>
      <span data-f="frontLine">{{frontLine}}</span>
      <span data-f="backHeading">{{backHeading}}</span>
      <span data-f="backText">{{backText}}</span>
      <span data-f="link">{{link}}</span>
      <span data-f="buttonText">{{buttonText}}</span>
    </div>
    {{/each}}
  </div>
</div>
