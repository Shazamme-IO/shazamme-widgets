{
  "_comment": "Self-documenting manifest of every data.config key Flip Cards reads (NOT a Duda-imposed format). The Duda editors are built from duda-ai-prompt-1/2/3; settings.test.ts keeps this file, those prompts and settings.ts in step. Duda serialises dropdowns and numbers as strings and toggles as booleans or strings; settings.ts coerces both.",
  "widget": "flip-cards",
  "fields": [
    { "key": "cards", "type": "list", "default": [], "help": "One item per card. Item keys: image, alt, title, frontLine, backHeading, backText, link, buttonText." },
    { "key": "flipStyle", "type": "dropdown", "default": "flip", "options": ["flip", "fade", "none"] },
    { "key": "flipDirection", "type": "dropdown", "default": "horizontal", "options": ["horizontal", "vertical"] },
    { "key": "flipSpeed", "type": "number", "default": 600, "min": 0, "max": 3000 },
    { "key": "flipOnHover", "type": "boolean", "default": true },
    { "key": "headingTag", "type": "dropdown", "default": "h3", "options": ["h2", "h3", "h4", "h5", "p", "div"] },
    { "key": "openInNewTab", "type": "boolean", "default": false },
    { "key": "columnsDesktop", "type": "number", "default": 3, "min": 1, "max": 6 },
    { "key": "columnsTablet", "type": "number", "default": 2, "min": 1, "max": 6 },
    { "key": "columnsMobile", "type": "number", "default": 1, "min": 1, "max": 6 },
    { "key": "gapDesktop", "type": "number", "default": 24, "min": 0, "max": 120 },
    { "key": "gapTablet", "type": "number", "default": 20, "min": 0, "max": 120 },
    { "key": "gapMobile", "type": "number", "default": 16, "min": 0, "max": 120 },
    { "key": "stretchLastRow", "type": "boolean", "default": false },
    { "key": "fillColumn", "type": "boolean", "default": false },
    { "key": "heightModeDesktop", "type": "dropdown", "default": "aspect", "options": ["fixed", "min", "aspect"] },
    { "key": "heightDesktop", "type": "number", "default": 380, "min": 80, "max": 1600 },
    { "key": "aspectDesktop", "type": "dropdown", "default": "4:5", "options": ["1:1", "4:3", "3:2", "16:9", "5:4", "4:5", "3:4", "2:3", "9:16"] },
    { "key": "heightModeTablet", "type": "dropdown", "default": "aspect", "options": ["fixed", "min", "aspect"] },
    { "key": "heightTablet", "type": "number", "default": 340, "min": 80, "max": 1600 },
    { "key": "aspectTablet", "type": "dropdown", "default": "4:5", "options": ["1:1", "4:3", "3:2", "16:9", "5:4", "4:5", "3:4", "2:3", "9:16"] },
    { "key": "heightModeMobile", "type": "dropdown", "default": "min", "options": ["fixed", "min", "aspect"] },
    { "key": "heightMobile", "type": "number", "default": 320, "min": 80, "max": 1600 },
    { "key": "aspectMobile", "type": "dropdown", "default": "4:5", "options": ["1:1", "4:3", "3:2", "16:9", "5:4", "4:5", "3:4", "2:3", "9:16"] },
    { "key": "radiusTopLeft", "type": "number", "default": 16, "min": 0, "max": 400 },
    { "key": "radiusTopRight", "type": "number", "default": 16, "min": 0, "max": 400 },
    { "key": "radiusBottomRight", "type": "number", "default": 16, "min": 0, "max": 400 },
    { "key": "radiusBottomLeft", "type": "number", "default": 16, "min": 0, "max": 400 }
  ]
}
