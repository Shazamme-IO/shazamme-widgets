<div class="shm-salary-au" data-shm-salary>
  <div class="shm-sc-card">
    <h2 class="shm-sc-title" data-t="title">{{title}}</h2>
    <p class="shm-sc-intro" data-t="intro">{{intro}}</p>

    <div class="shm-sc-pay">
      <h3 class="shm-sc-subtitle" data-t="payHeading">{{payHeading}}</h3>
      <div class="shm-sc-grid">
        <label class="shm-sc-field">
          <span class="shm-sc-label" data-t="payAmountLabel">{{payAmountLabel}}</span>
          <input class="shm-sc-input" type="number" inputmode="decimal" min="0" step="any" data-f="amount">
        </label>
        <label class="shm-sc-field">
          <span class="shm-sc-label" data-t="payPeriodLabel">{{payPeriodLabel}}</span>
          <select class="shm-sc-input" data-f="period">
            <option value="hourly" data-t="periodHourly">{{periodHourly}}</option>
            <option value="daily" data-t="periodDaily">{{periodDaily}}</option>
            <option value="weekly" data-t="periodWeekly">{{periodWeekly}}</option>
            <option value="monthly" data-t="periodMonthly">{{periodMonthly}}</option>
            <option value="annual" data-t="periodAnnual" selected>{{periodAnnual}}</option>
          </select>
        </label>
        <label class="shm-sc-field">
          <span class="shm-sc-label" data-t="hoursLabel">{{hoursLabel}}</span>
          <input class="shm-sc-input" type="number" inputmode="decimal" min="1" max="168" step="any" data-f="hours" value="38">
        </label>
        <label class="shm-sc-field">
          <span class="shm-sc-label" data-t="daysLabel">{{daysLabel}}</span>
          <input class="shm-sc-input" type="number" inputmode="decimal" min="1" max="7" step="any" data-f="days" value="5">
        </label>
      </div>
    </div>

    <fieldset class="shm-sc-options" data-shm-options>
      <legend class="shm-sc-legend" data-t="taxOptionsTitle">{{taxOptionsTitle}}</legend>
      <div class="shm-sc-opt" data-opt="residency">
        <label class="shm-sc-field">
          <span class="shm-sc-label" data-t="residencyLabel">{{residencyLabel}}</span>
          <select class="shm-sc-input" data-f="residency">
            <option value="resident" data-t="residencyResident">{{residencyResident}}</option>
            <option value="foreign" data-t="residencyForeign">{{residencyForeign}}</option>
            <option value="whm" data-t="residencyWhm">{{residencyWhm}}</option>
          </select>
        </label>
      </div>
      <div class="shm-sc-opt" data-opt="help">
        <label class="shm-sc-check">
          <input type="checkbox" data-f="help">
          <span class="shm-sc-checktext" data-t="helpLabel">{{helpLabel}}</span>
        </label>
      </div>
      <div class="shm-sc-opt" data-opt="superIncluded">
        <label class="shm-sc-check">
          <input type="checkbox" data-f="superIncluded">
          <span class="shm-sc-checktext" data-t="superIncludedLabel">{{superIncludedLabel}}</span>
        </label>
        <span class="shm-sc-help" data-t="superIncludedHelp">{{superIncludedHelp}}</span>
      </div>
    </fieldset>

    <p class="shm-sc-error" role="alert" data-shm-error hidden></p>
    <p class="shm-sc-sr" role="status" aria-live="polite" data-shm-live></p>
    <button type="button" class="shm-sc-btn" data-shm-calc data-t="calcButton">{{calcButton}}</button>

    <div class="shm-sc-results" data-shm-results hidden>
      <h3 class="shm-sc-subtitle" data-t="resultsHeading">{{resultsHeading}}</h3>
      <p class="shm-sc-tiles-heading" data-t="tilesHeading">{{tilesHeading}}</p>
      <div class="shm-sc-tiles">
        <div class="shm-sc-tile"><span class="shm-sc-tile-label" data-t="colYear">{{colYear}}</span><strong class="shm-sc-tile-value" data-tile="year"></strong></div>
        <div class="shm-sc-tile"><span class="shm-sc-tile-label" data-t="colMonth">{{colMonth}}</span><strong class="shm-sc-tile-value" data-tile="month"></strong></div>
        <div class="shm-sc-tile"><span class="shm-sc-tile-label" data-t="colFortnight">{{colFortnight}}</span><strong class="shm-sc-tile-value" data-tile="fortnight"></strong></div>
        <div class="shm-sc-tile"><span class="shm-sc-tile-label" data-t="colDay">{{colDay}}</span><strong class="shm-sc-tile-value" data-tile="day"></strong></div>
      </div>
      <div class="shm-sc-tablewrap">
        <table class="shm-sc-table">
          <thead>
            <tr>
              <td></td>
              <th scope="col" data-t="colYear">{{colYear}}</th>
              <th scope="col" data-t="colMonth">{{colMonth}}</th>
              <th scope="col" data-t="colFortnight">{{colFortnight}}</th>
              <th scope="col" data-t="colDay">{{colDay}}</th>
            </tr>
          </thead>
          <tbody>
            <tr data-row="totalPackage"><th scope="row" data-t="rowPackage">{{rowPackage}}</th><td data-col="year"></td><td data-col="month"></td><td data-col="fortnight"></td><td data-col="day"></td></tr>
            <tr data-row="gross"><th scope="row" data-t="rowGross">{{rowGross}}</th><td data-col="year"></td><td data-col="month"></td><td data-col="fortnight"></td><td data-col="day"></td></tr>
            <tr data-row="incomeTax"><th scope="row" data-t="rowIncomeTax">{{rowIncomeTax}}</th><td data-col="year"></td><td data-col="month"></td><td data-col="fortnight"></td><td data-col="day"></td></tr>
            <tr data-row="medicare"><th scope="row" data-t="rowMedicare">{{rowMedicare}}</th><td data-col="year"></td><td data-col="month"></td><td data-col="fortnight"></td><td data-col="day"></td></tr>
            <tr data-row="help"><th scope="row" data-t="rowHelp">{{rowHelp}}</th><td data-col="year"></td><td data-col="month"></td><td data-col="fortnight"></td><td data-col="day"></td></tr>
            <tr data-row="net" class="shm-sc-total"><th scope="row" data-t="rowTakeHome">{{rowTakeHome}}</th><td data-col="year"></td><td data-col="month"></td><td data-col="fortnight"></td><td data-col="day"></td></tr>
            <tr data-row="superAmount" class="shm-sc-super"><th scope="row" data-t="rowSuper">{{rowSuper}}</th><td data-col="year"></td><td data-col="month"></td><td data-col="fortnight"></td><td data-col="day"></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <p class="shm-sc-note" data-shm-note data-t="taxYearNote">{{taxYearNote}}</p>
    <p class="shm-sc-disclaimer" role="note" data-shm-disclaimer data-t="disclaimerText">{{disclaimerText}}</p>
  </div>
</div>
