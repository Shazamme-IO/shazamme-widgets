
{{#equals layouttypes "layout1"}}
<div class="main" id="desktopid">
    <div class="titlecls">{{titlecls}}</div>
    <div class="tabmain">
        <div class="tabtext1">{{tab1text}}</div>  
        <div class="tabtext2">{{tab2text}}</div>
    </div>        
    
    <div class="firsttablayout">
        <div class="clshourlylabel">{{hourlyrate}} {{#equals locdropdown "uk"}} ({{uksymbol}}): {{else}} ({{aussymbol}}): {{/equals}} </div>
        <div class="clshourlyinput"><input class="clsinputbox" type="text" id="hourlyRate" inputmode="numeric" pattern="[0-9]*"></div>
        <div class="clshoursperday">
            <div class="clshoursperdaylabel">{{hoursperdaytxt}}</div>
            <div class="clshoursperdayinput"><input class="clsinputbox" type="number" min="1" step="0.5" id="hoursPerDay"></div>
        </div>
        <div class="dmWidget clscalculate"><span class="text">{{calculatebtntxt}}</span></div>
        <div class="clsquestion">
            <div class="questionmarkcls" data-title="{{queexclusivegst}}">?</div>
        </div>
    </div>    
    
    <div class="secondtablayout" style="display:none">
        <div class="clsannual">
            <div class="curannualcls">{{currentannualsal}} {{#equals locdropdown "uk"}} ({{uksymbol}}) {{else}} ({{aussymbol}}) {{/equals}} </div>
            <div class="currentannualinput"><input class="clsinputbox" type="text" id="currentannual"></div>
        </div>
        <div class="clshourlysecond">
            <div class="secondhourlycls">{{secondhourly}}{{#equals locdropdown "uk"}} ({{uksymbol}}): {{else}} ({{aussymbol}}): {{/equals}} </div>
            <div class="secondhourlyinput"><input class="clsinputbox" type="number" id="secondhourly" readonly=""></div>
            <div class="clsquestion">
                <div class="questionmarkcls" data-title="{{quebasedhourstxt}}">?</div>
            </div>
        </div>
        <div class="clsaddloading">
            <div class="addloadcls">{{addloading}}</div>
            <div class="addloadinput"><input class="clsinputbox" type="text" id="addload" value="{{addloadtxt}}"></div>
            <div class="clsquestion">
                <div class="questionmarkcls" data-title="{{que25loadtxt}}">?</div>
            </div>
        </div>
        <div class="clshourlyplus">
            <div class="hourpluslycls">{{hourlyrateplus}} {{#equals locdropdown "uk"}} ({{uksymbol}}) {{else}} ({{aussymbol}}) {{/equals}}</div>
            <div class="hourlyplusinput"><input class="clsinputbox" type="number" id="hourlyplus" readonly=""></div>
        </div>
     </div>
    
