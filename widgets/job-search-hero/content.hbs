<form class="shm-jh" data-shm-jh role="search" aria-label="{{ariaLabel}}" novalidate>
  <label class="shm-jh-field shm-jh-field-keyword"><span class="shm-jh-label">{{keywordLabel}}</span><input class="shm-jh-input" type="text" name="keyword" autocomplete="off" placeholder="{{keywordPlaceholder}}"></label>
  <label class="shm-jh-field shm-jh-field-location"><span class="shm-jh-label">{{locationLabel}}</span><input class="shm-jh-input" type="text" name="location" autocomplete="off" placeholder="{{locationPlaceholder}}"></label>
  <label class="shm-jh-field shm-jh-field-worktype"><span class="shm-jh-label">{{workTypeLabel}}</span><select class="shm-jh-input" name="workType"><option value="">{{workTypeAllLabel}}</option></select></label>
  <button class="shm-jh-button" type="submit"><span class="shm-jh-button-text">{{buttonTextNoCount}}</span></button>
</form>
