{
  "_comment": "Duda Content Editor fields for google-reviews. The full panel (every layout, review, filter, badge and style option, grouped in tabs) is defined in duda-ai-prompt.md: paste that into Duda's AI in Widget Builder. Each field key is the setting name the widget reads from data.config.",
  "widget": "google-reviews",
  "fields": [
    {
      "key": "businessSearch",
      "label": "Business name and suburb",
      "type": "text",
      "default": "",
      "help": "Required. As it appears on Google Maps; the widget finds the business on Google."
    },
    {
      "key": "placeId",
      "label": "Google Place ID",
      "type": "text",
      "default": "",
      "help": "Optional. Only if the business-name search picks the wrong business."
    },
    {
      "key": "googleApiKey",
      "label": "Google Places API key",
      "type": "text",
      "default": "",
      "help": "Places API (New) key, restricted by HTTP referrer to the site's domains. Google returns the rating, review count and up to 5 reviews."
    },
    {
      "key": "feedUrl",
      "label": "Reviews feed URL (optional)",
      "type": "text",
      "default": "",
      "help": "A JSON feed of the full review history. When set it is used instead of the Places API."
    },
    {
      "key": "language",
      "label": "Review language",
      "type": "text",
      "default": "en",
      "help": "languageCode sent to Google, e.g. en, en-GB."
    },
    {
      "key": "layout",
      "label": "Layout",
      "type": "select",
      "options": [
        "",
        "carousel",
        "slider",
        "grid",
        "list",
        "masonry",
        "cardBadge"
      ],
      "default": "",
      "help": "Blank = use settingsJson."
    },
    {
      "key": "reviewLayout",
      "label": "Review card style",
      "type": "select",
      "options": [
        "",
        "classic",
        "balloon",
        "spotlight"
      ],
      "default": ""
    },
    {
      "key": "reviewSourceStyle",
      "label": "Google source style",
      "type": "select",
      "options": [
        "",
        "text",
        "logo",
        "icon",
        "logoBottom",
        "iconBottom"
      ],
      "default": ""
    },
    {
      "key": "headerLayout",
      "label": "Header style",
      "type": "select",
      "options": [
        "",
        "header1",
        "header2",
        "header4",
        "header7",
        "header9"
      ],
      "default": ""
    },
    {
      "key": "badgeDisplayMode",
      "label": "Badge position",
      "type": "select",
      "options": [
        "",
        "singleInline",
        "singleFloating"
      ],
      "default": "",
      "help": "Only for the cardBadge layout."
    },
    {
      "key": "showOverallRating",
      "label": "Show header (overall rating)",
      "type": "boolean",
      "default": ""
    },
    {
      "key": "showWriteReviewButton",
      "label": "Show 'Review us on Google' button",
      "type": "boolean",
      "default": ""
    },
    {
      "key": "widgetTitle",
      "label": "Show title",
      "type": "boolean",
      "default": ""
    },
    {
      "key": "widgetTitleTitle",
      "label": "Title text",
      "type": "text",
      "default": ""
    },
    {
      "key": "carouselAutoplay",
      "label": "Carousel autoplay",
      "type": "boolean",
      "default": ""
    },
    {
      "key": "filterMinRating",
      "label": "Minimum star rating",
      "type": "select",
      "options": [
        "",
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "default": ""
    },
    {
      "key": "includeKeywords",
      "label": "Only reviews mentioning (comma separated)",
      "type": "text",
      "default": "",
      "help": "e.g. a consultant's name \u2014 the Collins per-consultant widgets."
    },
    {
      "key": "excludeKeywords",
      "label": "Hide reviews mentioning (comma separated)",
      "type": "text",
      "default": ""
    },
    {
      "key": "cardBackground",
      "label": "Card background colour",
      "type": "color",
      "default": ""
    },
    {
      "key": "cardTextColour",
      "label": "Card text colour",
      "type": "color",
      "default": ""
    },
    {
      "key": "starColour",
      "label": "Star colour",
      "type": "color",
      "default": ""
    },
    {
      "key": "accentColour",
      "label": "Accent colour (links, button, badge)",
      "type": "color",
      "default": ""
    },
    {
      "key": "fontFamily",
      "label": "Google Font family",
      "type": "text",
      "default": "",
      "help": "e.g. Roboto, Open Sans. Blank inherits the site font."
    }
  ]
}
