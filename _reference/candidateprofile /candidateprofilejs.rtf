let answerWordBreak = (v, maxLength = 1500) => \{\
    if (typeof(v.answer) !== 'string') \{\
        return [v];\
    \}\
\
    if (v.answer.length <= maxLength) \{\
        return [v];\
    \}\
\
    let question = v.question;\
    let broken = [];\
    let words = v.answer.match(/\\b(\\w+)\\b/g);\
    let chunk = [];\
    let read = 0;\
\
    while (true) \{\
        let word = words.shift();\
\
        if (!word) \{\
            break;\
        \}\
\
        read += word.length;\
\
        if (read >= maxLength) \{\
            broken.push(\{\
                question: question,\
                answer: chunk.join(' '),\
                sortOrder: v.sortOrder,\
                pageBreak: true,\
            \});\
\
            chunk = [];\
            read = word.length;\
            question = v.question + ' (Cont)';\
        \}\
\
        chunk.push(word);\
    \}\
\
    broken.push(\{\
        question: question,\
        answer: chunk.join(' '),\
        sortOrder: v.sortOrder,\
        pageBreak: true,\
    \});\
\
    return broken;\
\}\
